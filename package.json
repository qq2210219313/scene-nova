{
  "name": "scene-nova",
  "version": "0.0.0",
  "description": "基于 Three.js 的轻量级 Web 3D SDK，对常用能力进行模块化封装，提供简单统一的三维内容构建与场景管理方式。",
  "keywords": [
    "three",
    "threejs",
    "3d",
    "webgl",
    "sdk",
    "typescript"
  ],
  "homepage": "https://github.com/qq2210219313/scene-nova#readme",
  "bugs": {
    "url": "https://github.com/qq2210219313/scene-nova/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qq2210219313/scene-nova.git"
  },
  "license": "MIT",
  "author": "qq2210219313",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:package": "publint",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "publint": "^0.3.24",
    "three": "^0.186.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.1"
  }
}
